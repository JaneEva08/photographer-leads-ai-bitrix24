# Скопируйте в .env и заполните. Сюда, в .env.example, настоящие ключи НЕ пишем.

# GigaChat: Authorization key из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к корневому сертификату НУЦ Минцифры (https://www.gosuslugi.ru/crt), например certs/russian_trusted_root_ca.cer
GIGACHAT_CA_BUNDLE_FILE=

# Битрикс24: базовая ссылка входящего вебхука (права crm, task, im), до последнего слэша
B24_URL=
# Кому слать уведомления (ID пользователя). Пусто — владельцу вебхука
B24_NOTIFY_USER_ID=

# Показывать на странице блок «Что ушло в нейросеть». Только для демо и проверки
DEMO_MODE=false

# Пароль для /admin и служебных API (логин admin). Пусто — без пароля, только для локального запуска
ADMIN_PASSWORD=
# Зафиксировать «сегодня» для демо и протокола (ГГГГ-ММ-ДД), иначе скидки и свободные даты «плывут». Пусто — настоящая дата
APP_TODAY=

# Мониторинг: адрес приёма логов Grafana Loki. Пусто — логи только в консоль.
# Локально, со стеком из папки monitoring/: http://localhost:3100/loki/api/v1/push
LOKI_URL=
# Метки в Loki: имя приложения и окружение (local, prod). Помогают различать проекты на одном дашборде
LOKI_APP=photo-leads-ai
LOKI_ENV=local
